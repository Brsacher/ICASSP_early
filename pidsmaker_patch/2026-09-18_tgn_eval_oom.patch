 TGNMessageStoreType = Dict[int, Tuple[Tensor, Tensor, Tensor, Tensor]]
 
+# ecpg patch 2026-09-18: cap peak VRAM of the eval-mode all-node flush.
+# One chunk covers the same nodes as a single arange(num_nodes) call.
+_EVAL_FLUSH_CHUNK = 262144
+
+
+def _update_memory_all_nodes_chunked(update_fn, num_nodes, device, chunk_size=_EVAL_FLUSH_CHUNK):
+    """Call ``update_fn`` on contiguous node-id slices covering ``[0, num_nodes)``.
+
+    Same coverage as ``update_fn(torch.arange(num_nodes, device=device))``.
+    Does not touch the message store or any other module state between chunks.
+    """
+    n_all = torch.arange(num_nodes, device=device)
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
+    for start in range(0, int(num_nodes), chunk_size):
+        update_fn(n_all[start : start + chunk_size])
+
 
